{
  "entities": {
    "Reading": {
      "title": "Soil Reading",
      "description": "Captured moisture, temperature, and salinity data",
      "type": "object",
      "properties": {
        "moisture": { "type": "number" },
        "temperature": { "type": "number" },
        "ec": { "type": "number" },
        "classification": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["moisture", "temperature", "ec", "classification", "timestamp"]
    },
    "Alert": {
      "title": "System Alert",
      "description": "Triggered anomalies in soil metrics",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["Warning", "Critical"] },
        "resolved": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "type", "resolved", "timestamp"]
    }
  },
  "firestore": {
    "/readings/{readingId}": {
      "schema": "Reading",
      "description": "Journal of soil sensor packets"
    },
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Log of critical agricultural events"
    }
  }
}
